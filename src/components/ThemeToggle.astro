<button class="theme-toggle" type="button" aria-label="Switch colour theme" aria-pressed="false" data-theme-toggle>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.3A8.2 8.2 0 0 1 8.7 3.8 8.3 8.3 0 1 0 20.2 15.3Z" /></svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <span>Theme</span>
</button>

<script>
  const bindThemeToggle = () => {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    const update = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      button.setAttribute('aria-pressed', String(dark));
      button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    update();
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      update();
    });
  };
  bindThemeToggle();
  document.addEventListener('astro:page-load', bindThemeToggle);
</script>

<style>
  .theme-toggle { min-height: 42px; padding: 0 14px; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border-strong); border-radius: 8px; color: var(--ink); background: transparent; font: inherit; font-size: .92rem; cursor: pointer; }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .theme-toggle svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle .sun, :global(html[data-theme='dark']) .theme-toggle .moon { display: none; }
  :global(html[data-theme='dark']) .theme-toggle .sun { display: block; }
  @media (max-width: 720px) { .theme-toggle { width: 44px; padding: 0; justify-content: center; } .theme-toggle span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
</style>
