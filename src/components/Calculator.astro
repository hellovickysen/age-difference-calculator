---
const days = Array.from({ length: 31 }, (_, index) => index + 1);
const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1899 }, (_, index) => currentYear - index);
---
<section class="calculator-shell" id="calculator" aria-label="Age difference calculator">
  <form class="calculator-form" data-calculator novalidate>
    <div class="date-row">
      <fieldset class="date-field" data-date-group="first" aria-describedby="first-date-hint">
        <legend>First person’s date of birth</legend>
        <div class="date-parts">
          <label class="date-part"><span>Day</span><select name="firstDay" aria-label="First person’s birth day" required><option value="">DD</option>{days.map((day) => <option value={day}>{String(day).padStart(2, '0')}</option>)}</select></label>
          <label class="date-part"><span>Month</span><select name="firstMonth" aria-label="First person’s birth month" required><option value="">Month</option>{months.map((month, index) => <option value={index + 1}>{month}</option>)}</select></label>
          <label class="date-part year"><span>Year</span><select name="firstYear" aria-label="First person’s birth year" required><option value="">YYYY</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
        </div>
        <small id="first-date-hint">Enter as DD / MM / YYYY</small>
      </fieldset>
      <button class="swap-connector" type="button" data-swap aria-label="Swap dates">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 3-3m-3 3 3 3M7 7h10M17 17l-3-3m3 3-3 3M17 17H7" /></svg>
      </button>
      <fieldset class="date-field" data-date-group="second" aria-describedby="second-date-hint">
        <legend>Second person’s date of birth</legend>
        <div class="date-parts">
          <label class="date-part"><span>Day</span><select name="secondDay" aria-label="Second person’s birth day" required><option value="">DD</option>{days.map((day) => <option value={day}>{String(day).padStart(2, '0')}</option>)}</select></label>
          <label class="date-part"><span>Month</span><select name="secondMonth" aria-label="Second person’s birth month" required><option value="">Month</option>{months.map((month, index) => <option value={index + 1}>{month}</option>)}</select></label>
          <label class="date-part year"><span>Year</span><select name="secondYear" aria-label="Second person’s birth year" required><option value="">YYYY</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
        </div>
        <small id="second-date-hint">Enter as DD / MM / YYYY</small>
      </fieldset>
    </div>
    <p class="form-error" data-error role="alert" hidden></p>
    <div class="form-actions">
      <button class="button primary" type="submit">Calculate age difference</button>
      <div class="secondary-actions">
        <button class="button secondary" type="button" data-swap>↔ <span>Swap dates</span></button>
        <button class="button secondary" type="reset">↶ <span>Reset</span></button>
      </div>
    </div>
    <div class="result" data-result aria-live="polite" hidden>
      <div class="result-label"><span class="check" aria-hidden="true">✓</span><h2>Exact age difference</h2></div>
      <p class="result-statement" data-statement></p>
      <p class="result-value"><strong data-years></strong> <span data-year-unit></span> <strong data-months></strong> <span data-month-unit></span> <strong data-days></strong> <span data-day-unit></span></p>
      <div class="result-totals"><span data-total-days></span><span data-weeks></span></div>
      <p class="privacy-note"><span aria-hidden="true">▣</span> Your dates stay on this device.</p>
    </div>
  </form>
</section>

<script>
  import { calendarDifference, parseDateInput } from '../lib/dateDifference.js';
  const bindCalculator = () => {
    const form = document.querySelector<HTMLFormElement>('[data-calculator]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';
    const field = (name: string) => form.elements.namedItem(name) as HTMLSelectElement;
    const first = [field('firstDay'), field('firstMonth'), field('firstYear')];
    const second = [field('secondDay'), field('secondMonth'), field('secondYear')];
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const result = form.querySelector<HTMLElement>('[data-result]')!;

    const readDate = (fields: HTMLSelectElement[], person: string) => {
      const [dayText, monthText, yearText] = fields.map((select) => select.value);
      if (!dayText || !monthText || !yearText) throw new Error(`Enter the complete date of birth for the ${person} person.`);
      const day = Number(dayText), month = Number(monthText), year = Number(yearText);
      const date = parseDateInput(`${yearText}-${monthText.padStart(2, '0')}-${dayText.padStart(2, '0')}`);
      if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) throw new Error(`Enter a valid date of birth for the ${person} person.`);
      return date;
    };

    const render = () => {
      let a: Date, b: Date;
      try {
        a = readDate(first, 'first');
        b = readDate(second, 'second');
      } catch (problem) {
        error.textContent = problem instanceof Error ? problem.message : 'Check both dates and try again.';
        error.hidden = false; result.hidden = true; return;
      }
      const today = new Date(); const todayUtc = Date.UTC(today.getFullYear(), today.getMonth(), today.getDate());
      if (a.getTime() > todayUtc || b.getTime() > todayUtc) { error.textContent = 'Dates of birth cannot be in the future.'; error.hidden = false; result.hidden = true; return; }
      const diff = calendarDifference(a, b);
      error.hidden = true; result.hidden = false;
      form.querySelector<HTMLElement>('[data-statement]')!.textContent = a.getTime() === b.getTime() ? 'Both people have the same date of birth' : `${a < b ? 'The first' : 'The second'} person is older by`;
      form.querySelector('[data-years]')!.textContent = String(diff.years);
      form.querySelector('[data-months]')!.textContent = String(diff.months);
      form.querySelector('[data-days]')!.textContent = String(diff.days);
      form.querySelector('[data-year-unit]')!.textContent = diff.years === 1 ? 'year' : 'years';
      form.querySelector('[data-month-unit]')!.textContent = diff.months === 1 ? 'month' : 'months';
      form.querySelector('[data-day-unit]')!.textContent = diff.days === 1 ? 'day' : 'days';
      form.querySelector('[data-total-days]')!.textContent = `${diff.totalDays.toLocaleString('en-IN')} days apart`;
      const weeks = Math.floor(diff.totalDays / 7), remainder = diff.totalDays % 7;
      form.querySelector('[data-weeks]')!.textContent = `${weeks.toLocaleString('en-IN')} weeks and ${remainder} ${remainder === 1 ? 'day' : 'days'}`;
    };
    form.addEventListener('submit', (event) => { event.preventDefault(); render(); });
    form.querySelectorAll<HTMLButtonElement>('[data-swap]').forEach((button) => button.addEventListener('click', () => {
      first.forEach((input, index) => { [input.value, second[index].value] = [second[index].value, input.value]; });
      error.hidden = true;
      if (!result.hidden) render();
    }));
    form.addEventListener('reset', () => setTimeout(() => { error.hidden = true; result.hidden = true; }, 0));
  };
  bindCalculator();
  document.addEventListener('astro:page-load', bindCalculator);
</script>
