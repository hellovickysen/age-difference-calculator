---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = post.data.relatedPosts.map((id: string) => allPosts.find((entry) => entry.id === id)).filter(Boolean);
const readingMinutes = Math.max(3, Math.ceil((post.body ?? '').split(/\s+/).length / 210));
const canonical = `https://agedifferencecalculator.xyz/blog/${post.id}/`;
const articleLd = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, inLanguage: 'en-IN', mainEntityOfPage: canonical, author: { '@type': 'Person', name: 'Priyabrata Sen', url: 'https://agedifferencecalculator.xyz/author/priyabrata-sen/' }, publisher: { '@type': 'Person', name: 'Priyabrata Sen' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://agedifferencecalculator.xyz/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://agedifferencecalculator.xyz/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ] },
];
---
<BaseLayout title={`${post.data.title} | Age Difference Calculator`} description={post.data.description} active="guides" type="article" structuredData={articleLd}>
  <nav class="breadcrumbs wrap" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/blog/">Guides</a></li><li aria-current="page">{post.data.title}</li></ol></nav>
  <header class="article-header wrap"><h1>{post.data.title}</h1><p class="standfirst">{post.data.description}</p><div class="article-meta"><span>Written by <a href="/author/priyabrata-sen/">Priyabrata Sen</a></span><span>{readingMinutes} min read</span></div></header>
  <div class="article-grid wrap">
    <article class="article-content">
      <Content />
      <a class="tool-cta" href="/#calculator"><span>Use the Age Difference Calculator</span><span aria-hidden="true">→</span></a>
      <aside class="related" aria-labelledby="related-title"><h2 id="related-title">Related guides</h2><div class="related-links">{related.map((item: any) => <a href={`/blog/${item.id}/`}>{item.data.title}</a>)}</div></aside>
      <p class="author-note">This guide was written and checked by <a href="/author/priyabrata-sen/">Priyabrata Sen</a> using real date examples. See <a href="/methodology/">how the calculator works</a>.</p>
    </article>
    <aside class="toc" aria-label="In this guide"><strong>In this guide</strong>{headings.filter((heading) => heading.depth === 2).slice(0, 6).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</aside>
  </div>
</BaseLayout>
