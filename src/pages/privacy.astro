import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy" description="Privacy information for Age Difference Calculator, including how dates entered into the calculator are handled.">
  <header class="page-heading wrap"><h1>Privacy policy</h1><p>Last updated: 6 September 2026</p></header>
  <article class="prose-page wrap"><h2>Calculator data</h2><p>The dates you enter are processed in your browser. They are not submitted to our server, saved to an account or placed in the page URL.</p><h2>Theme preference</h2><p>If you choose light or dark mode, that preference is saved in your browser using local storage. It contains no date-of-birth information.</p><h2>Analytics</h2><p>Basic, privacy-conscious traffic analytics may be enabled to understand page visits and site performance. This policy will be updated with the specific provider before analytics is activated.</p><h2>Contact</h2><p>For a privacy question, use the details on the <a href="/contact/">contact page</a>.</p></article>
</BaseLayout>
